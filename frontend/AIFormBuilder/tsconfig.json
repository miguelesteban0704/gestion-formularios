{
  // Acotado a propósito: `include` cubre SOLO los ficheros TypeScript.
  // Añadir "src" aquí metería los ~60 .jsx del proyecto en el chequeo y
  // `tsc` exigiría `allowJs`/`checkJs`, que|reportaría cientos de errores
  // preexistentes que no tienen nada que ver con esta integración.
  //
  // Lo que sí hace: cualquier `.ts`/`.tsx` nuevo queda tipado y comprobado
  // sin obligar a migrar el resto del proyecto.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "sonner": ["./src/components/ui/Toast.tsx"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
