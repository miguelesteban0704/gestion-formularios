// =============================================================
//  Timely Forms AI — Referencia Prisma (schema.prisma)
// -------------------------------------------------------------
//  NOTA: el backend usa PostgreSQL con sentencias SQL directas
//  (config/db.js → migrate()). Este archivo es la referencia
//  equivalente en Prisma por si se quiere migrar el ORM a futuro.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String?       @unique
  externalId    String?       @unique @map("external_id")
  avatarColor   String        @default("#0c8b7c") @map("avatar_color")
  avatarUrl     String?       @map("avatar_url")
  lastName      String        @default("") @map("last_name")
  bio           String        @default("")
  username      String?       @unique
  isActive      Boolean       @default(true) @map("is_active")
  deletedAt     DateTime?     @map("deleted_at")
  passwordHash  String?       @map("password_hash")
  passwordSetAt DateTime?     @map("password_set_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  settings      UserSettings?
  sessions      UserSession[]
  forms         Form[]
  notifications Notification[]
}

model UserSettings {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  username          String?
  lastName          String   @default("") @map("last_name")
  bio               String   @default("")
  timezone          String   @default("UTC")
  language          String   @default("es")
  dateFormat        String   @default("DD/MM/YYYY") @map("date_format")
  theme             String   @default("system") // system | light | dark
  accentColor       String   @default("#15a18b") @map("accent_color")
  notificationPrefs Json     @default("{\"new_response\":{\"email\":true,\"push\":true,\"in_app\":true},\"form_milestone\":{\"email\":true,\"push\":false,\"in_app\":true},\"weekly_summary\":{\"email\":true,\"push\":false,\"in_app\":false},\"security_alert\":{\"email\":true,\"push\":true,\"in_app\":true},\"product_updates\":{\"email\":false,\"push\":false,\"in_app\":true}}") @map("notification_prefs")
  emailDigest       String   @default("weekly") @map("email_digest") // immediate | daily | weekly | none
  totpEnabled       Boolean  @default(false) @map("totp_enabled")
  totpSecret        String?  @map("totp_secret")
  totpVerifiedAt    DateTime? @map("totp_verified_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  jti        String   @unique
  deviceInfo Json     @default("{}") @map("device_info")
  ip         String?
  userAgent  String?  @map("user_agent")
  isActive   Boolean  @default(true) @map("is_active")
  lastActive DateTime @default(now()) @map("last_active")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, lastActive(sort: Desc)])
  @@index([jti])
}

model Form {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner          String    @db.Uuid
  title          String    @default("Untitled form")
  description    String    @default("")
  theme          String    @default("modern")
  status         String    @default("draft")
  slug           String    @unique
  questions      Json      @default("[]")
  settings       Json      @default("{}")
  views          Int       @default(0)
  responseCount  Int       @default(0) @map("response_count")
  isFavorite     Boolean   @default(false) @map("is_favorite")
  isArchived     Boolean   @default(false) @map("is_archived")
  publishedAt    DateTime? @map("published_at")
  creationSource String    @default("blank") @map("creation_source")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  ownerUser  User        @relation(fields: [owner], references: [id], onDelete: Cascade)
  responses  Response[]
  notifications Notification[]

  @@index([owner, isArchived, updatedAt(sort: Desc)])
}

model Response {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  form           String   @db.Uuid
  answers        Json     @default("[]")
  completionTime Int      @default(0) @map("completion_time")
  meta           Json     @default("{}")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  formOwner Form @relation(fields: [form], references: [id], onDelete: Cascade)

  @@index([form, submittedAt(sort: Desc)])
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  formId      String?  @unique @map("form_id") @db.Uuid
  type        String
  source      String
  title       String
  description String   @default("")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  form Form? @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

